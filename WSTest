using System;
using System.Collections;
using System.Collections.Generic;
using System.Text;
using System.Runtime.InteropServices;
using System.Threading.Tasks;
using NativeWebSocket;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;

// Define base response class
[Serializable]
public class ServerResponse
{
    public JObject on; // The "on" field as JObject for flexibility
    public bool? authentication;
    [JsonProperty("is")] // Use JsonProperty to map the JSON field "is" to a valid C# property name
    public Dictionary<string, bool> EnvironmentFlags; // Renamed to avoid keyword conflict; holds flags like test, dev, demo, etc.
    public Dictionary<string, string> server;
    public string[] set_cookie;
    public Wallet wallet;
    // Add more common fields as needed
}

[Serializable]
public class Wallet
{
    public int balance;
    public string currency;
}

