public class WSTest : MonoBehaviour
{
    private WebSocket _ws;
    private bool _isConnected;

#if UNITY_WEBGL && !UNITY_EDITOR
    [DllImport("__Internal")]
    private static extern IntPtr GetLocation();

    [DllImport("__Internal")]
    private static extern IntPtr GetCookies();

    public static string GetWindowLocation()
    {
        IntPtr ptr = GetLocation();
        return Marshal.PtrToStringUTF8(ptr);
    }

    public static string GetDocumentCookie()
    {
        IntPtr ptr = GetCookies();
        return Marshal.PtrToStringUTF8(ptr);
    }
#else
    public static string GetWindowLocation() => "{}";
    public static string GetDocumentCookie() => "";
#endif

    // Events for each response type
    public event Action<ServerResponse> OnAuthenticationResponse;
    public event Action<GameListResponse> OnGameListResponse;
    public event Action<SetGameResponse> OnSetGameResponse;
    public event Action<OptionsResponse> OnOptionsResponse;
    public event Action<PaytableResponse> OnPaytableResponse;
    public event Action<BetResponse> OnBetResponse;
    // Add more events as needed for other responses

    private async void Start()
    {
        Debug.Log(GetWindowLocation() + " WINDOW LOC");
        Debug.Log(GetDocumentCookie() + " COOKIE");

        _ws = new WebSocket("wss://wss.polishchuk.com/nonstop-ws");

        _ws.OnOpen += () =>
        {
            Debug.Log("Connected to server");
            _isConnected = true;
            SendAuthentication();
        };

        _ws.OnMessage += (bytes) =>
        {
            var msg = Encoding.UTF8.GetString(bytes);
            Debug.Log("📩 Received: " + msg);
            HandleResponse(msg);
        };

        _ws.OnError += (err) => Debug.LogError("WebSocket error: " + err);

        _ws.OnClose += (code) =>
        {
            Debug.LogWarning("WebSocket closed: " + code);
            _isConnected = false;
        };

        await _ws.Connect();
    }

    private void Update()
    {
#if !UNITY_WEBGL || UNITY_EDITOR
        _ws?.DispatchMessageQueue();
#endif
    }

    private async void OnApplicationQuit()
    {
        if (_ws != null)
            await _ws.Close();
    }

    // Handle incoming response
    private void HandleResponse(string jsonString)
    {
        try
        {
            JObject json = JObject.Parse(jsonString);

            if (json["on"] == null) return;

            JObject onObj = json["on"] as JObject;
            string command = null;

            if (onObj["set"] != null)
            {
                command = onObj["set"].ToString();
            }
            else if (onObj["get"] != null)
            {
                command = onObj["get"].ToString();
            }

            if (command == null) return;

            switch (command)
            {
                case "authentication":
                    var authResp = JsonConvert.DeserializeObject<ServerResponse>(jsonString);
                    OnAuthenticationResponse?.Invoke(authResp);
                    break;
                case "game_list":
                    var gameListResp = JsonConvert.DeserializeObject<GameListResponse>(jsonString);
                    OnGameListResponse?.Invoke(gameListResp);
                    break;
                case "game":
                    var setGameResp = JsonConvert.DeserializeObject<SetGameResponse>(jsonString);
                    OnSetGameResponse?.Invoke(setGameResp);
                    break;
                case "options":
                    var optionsResp = JsonConvert.DeserializeObject<OptionsResponse>(jsonString);
                    OnOptionsResponse?.Invoke(optionsResp);
                    break;
                case "paytable":
                    var paytableResp = JsonConvert.DeserializeObject<PaytableResponse>(jsonString);
                    OnPaytableResponse?.Invoke(paytableResp);
                    break;
                case "bet":
                    var betResp = JsonConvert.DeserializeObject<BetResponse>(jsonString);
                    OnBetResponse?.Invoke(betResp);
                    break;
                // Add more cases for other commands
                default:
                    Debug.LogWarning("Unhandled command: " + command);
                    break;
            }
        }
        catch (Exception e)
        {
            Debug.LogError("Error parsing response: " + e.Message);
        }
    }

    // Send methods
    public async Task SendAuthentication()
    {
        var auth = new JObject
        {
            ["set"] = "authentication",
            ["location"] = JObject.Parse(GetWindowLocation()), // Parse to JObject if it's string JSON
            ["cookie"] = GetDocumentCookie()
        };
        await SendJson(auth);
    }

    public async Task GetGameList()
    {
        var req = new JObject { ["get"] = "game_list" };
        await SendJson(req);
    }

    public async Task SetGame(string gameTag)
    {
        var req = new JObject
        {
            ["set"] = "game",
            ["game"] = gameTag
        };
        await SendJson(req);
    }

    public async Task GetOptions()
    {
        var req = new JObject { ["get"] = "options" };
        await SendJson(req);
    }

    public async Task GetPaytable(bool multiplier)
    {
        var req = new JObject
        {
            ["get"] = "paytable",
            ["multiplier"] = multiplier
        };
        await SendJson(req);
    }

    // Add more send methods as needed

    private async Task SendJson(JObject json)
    {
        if (!_isConnected)
        {
            Debug.LogWarning("⚠️ Not connected yet!");
            return;
        }

        string msg = json.ToString(Formatting.None);
        Debug.Log("➡️ Sending: " + msg);
        await _ws.SendText(msg);
    }
}
